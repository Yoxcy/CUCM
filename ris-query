if __name__ == "__main__":

    debug_mode = "--debug" in sys.argv

    if not ZEEP_AVAILABLE:
        log.warning("zeep not installed — Methods 1 & 2 unavailable, using Method 3 only")
        log.warning("To install: pip install zeep")

    log.info(f"CUCM RIS Query — Target: {CUCM_HOST}")
    log.info(f"Devices to query: {len(DEVICE_NAMES)}")

    start_time = datetime.now()

    try:
        results, method_used = query_with_fallback(
            cucm_host    = CUCM_HOST,
            username     = USERNAME,
            password     = PASSWORD,
            device_names = DEVICE_NAMES,
            verify_ssl   = VERIFY_SSL,
            chunk_size   = CHUNK_SIZE,
        )
    except RuntimeError as e:
        log.error(str(e))
        sys.exit(1)

    elapsed = (datetime.now() - start_time).total_seconds()
    log.info(f"Completed in {elapsed:.1f}s using {method_used}")

    # Display results
    print_results_table(results, DEVICE_NAMES, method_used)

    # Export
    export_csv(results,  DEVICE_NAMES, OUTPUT_CSV)
    export_json(results, DEVICE_NAMES, OUTPUT_JSON)
