def print_results_table(results, device_names, method_used):
    """Print a formatted summary table to stdout."""
    col = {"name": 28, "status": 16, "ip": 18, "node": 25}
    sep = "-" * 100

    print(f"\n{sep}")
    print(f"  Query method: {method_used}")
    print(sep)
    print(
        f"{'Device Name':<{col['name']}} "
        f"{'Status':<{col['status']}} "
        f"{'IP Address':<{col['ip']}} "
        f"{'Node':<{col['node']}} "
        f"DN(s)"
    )
    print(sep)

    registered = unregistered = not_found = 0

    for name in device_names:
        if name in results:
            d   = results[name]
            ip  = d["ip_address"] or d["ipv6_address"] or "-"
            dns = ", ".join(x["dn"] for x in d["dir_numbers"]) or "-"

            print(
                f"{name:<{col['name']}} "
                f"{d['status']:<{col['status']}} "
                f"{ip:<{col['ip']}} "
                f"{d['node']:<{col['node']}} "
                f"{dns}"
            )
            if str(d["status"]).lower() == "registered":
                registered += 1
            else:
                unregistered += 1
        else:
            print(
                f"{name:<{col['name']}} "
                f"{'NOT FOUND':<{col['status']}} "
                f"{'-':<{col['ip']}} "
                f"{'-':<{col['node']}} "
                f"-"
            )
            not_found += 1

    print(sep)
    print(
        f"Total: {len(device_names)}  |  "
        f"Registered: {registered}  |  "
        f"Unregistered: {unregistered}  |  "
        f"Not Found: {not_found}"
    )
    print(sep)


def export_csv(results, device_names, filepath):
    """Export results to a CSV file."""
    fieldnames = [
        "device_name", "status", "ip_address", "ipv6_address",
        "node", "model", "description", "login_user", "dir_numbers",
    ]
    with open(filepath, "w", newline="", encoding="utf-8") as f:
        writer = csv.DictWriter(f, fieldnames=fieldnames)
        writer.writeheader()
        for name in device_names:
            if name in results:
                d = results[name]
                writer.writerow({
                    "device_name":  name,
                    "status":       d["status"],
                    "ip_address":   d["ip_address"],
                    "ipv6_address": d["ipv6_address"],
                    "node":         d["node"],
                    "model":        d["model"],
                    "description":  d["description"],
                    "login_user":   d["login_user"],
                    "dir_numbers":  "; ".join(x["dn"] for x in d["dir_numbers"]),
                })
            else:
                writer.writerow({
                    "device_name": name,
                    "status": "NOT_FOUND",
                    **{k: "" for k in fieldnames[2:]},
                })
    log.info(f"CSV exported → {filepath}")


def export_json(results, device_names, filepath):
    """Export results to a JSON file."""
    output = [
        {"device_name": name, **results[name]} if name in results
        else {"device_name": name, "status": "NOT_FOUND"}
        for name in device_names
    ]
    with open(filepath, "w", encoding="utf-8") as f:
        json.dump(output, f, indent=2)
    log.info(f"JSON exported → {filepath}")


