def load_devices_from_file(filepath):
    """Load device names from a plain text file, one name per line."""
    try:
        with open(filepath, "r") as f:
            names = [line.strip() for line in f if line.strip()]
        log.info(f"Loaded {len(names)} device names from {filepath}")
        return names
    except FileNotFoundError:
        log.error(f"Device file not found: {filepath}")
        sys.exit(1)


def parse_xml_response(xml_text):
    """
    Parse raw RIS SOAP XML response (used by Method 2 fallback and Method 3).
    Returns dict: { DeviceName -> { status, ip_address, ipv6_address, node, ... } }
    """
    devices = {}

    ns = {
        "env":  "http://schemas.xmlsoap.org/soap/envelope/",
        "soap": "http://schemas.cisco.com/ast/soap",
    }

    try:
        root = ET.fromstring(xml_text)
    except ET.ParseError as e:
        log.error(f"Failed to parse XML response: {e}")
        log.debug(f"Raw response (first 1000 chars):\n{xml_text[:1000]}")
        return devices

    # Check for SOAP fault
    fault = root.find(".//faultstring")
    if fault is not None:
        log.error(f"SOAP Fault: {fault.text}")
        return devices

    for cm_node in root.findall(".//soap:CmNode", ns):
        node_name = cm_node.findtext("soap:Name", default="", namespaces=ns)

        for device in cm_node.findall(".//soap:CmDevice", ns):
            name = device.findtext("soap:Name", default="", namespaces=ns)
            if not name:
                continue

            dir_numbers = []
            for line in device.findall(".//soap:LineStatus", ns):
                dn          = line.findtext("soap:DirectoryNumber", default="", namespaces=ns)
                line_status = line.findtext("soap:Status",          default="", namespaces=ns)
                if dn:
                    dir_numbers.append({"dn": dn, "status": line_status})

            devices[name] = {
                "status":       device.findtext("soap:Status",      default="", namespaces=ns),
                "ip_address":   device.findtext("soap:IpAddress",   default="", namespaces=ns),
                "ipv6_address": device.findtext("soap:Ipv6Address", default="", namespaces=ns),
                "node":         node_name,
                "model":        device.findtext("soap:Model",       default="", namespaces=ns),
                "description":  device.findtext("soap:Description", default="", namespaces=ns),
                "login_user":   device.findtext("soap:LoginUserId", default="", namespaces=ns),
                "dir_numbers":  dir_numbers,
            }

    return devices


def parse_zeep_response(response):
    """
    Parse a Zeep response object (Method 1 and Method 2).
    Returns dict: { DeviceName -> { status, ip_address, ... } }
    """
    devices = {}

    try:
        cm_nodes = response.SelectCmDeviceResult.CmNodes
    except AttributeError:
        log.warning("Response missing SelectCmDeviceResult.CmNodes — empty result")
        return devices

    if not cm_nodes or not cm_nodes.item:
        return devices

    for node in cm_nodes.item:
        node_name = getattr(node, "Name", "")

        if not node.CmDevices or not node.CmDevices.item:
            continue

        for device in node.CmDevices.item:
            name = getattr(device, "Name", "")
            if not name:
                continue

            dir_numbers = []
            try:
                lines = device.LinesStatus.item if device.LinesStatus else []
                for line in lines:
                    dn          = getattr(line, "DirectoryNumber", "")
                    line_status = getattr(line, "Status", "")
                    if dn:
                        dir_numbers.append({"dn": dn, "status": line_status})
            except (AttributeError, TypeError):
                pass

            devices[name] = {
                "status":       getattr(device, "Status",      "") or "",
                "ip_address":   getattr(device, "IpAddress",   "") or "",
                "ipv6_address": getattr(device, "Ipv6Address", "") or "",
                "node":         node_name,
                "model":        getattr(device, "Model",       "") or "",
                "description":  getattr(device, "Description", "") or "",
                "login_user":   getattr(device, "LoginUserId", "") or "",
                "dir_numbers":  dir_numbers,
            }

    return devices


# ═════════════════════════════════════════════════════════════════════════════
# METHOD 1 — ZEEP TYPE FACTORY
# ═════════════════════════════════════════════════════════════════════════════

def _m1_build_client(cucm_host, username, password, verify_ssl):
    """Build Zeep client and return (client, history, service)."""
    wsdl_url  = f"https://{cucm_host}:8443/realtimeservice2/services/RISService70?wsdl"
    session   = requests.Session()
    session.auth   = HTTPBasicAuth(username, password)
    session.verify = verify_ssl

    transport = Transport(session=session, timeout=60, operation_timeout=60)
    history   = HistoryPlugin()
    client    = Client(wsdl=wsdl_url, transport=transport, plugins=[history])

    binding  = "{http://schemas.cisco.com/ast/soap}RisBinding"
    endpoint = f"https://{cucm_host}:8443/realtimeservice2/services/RISService70"
    service  = client.create_service(binding, endpoint)

    return client, history, service


def _m1_get_factory(client):
    """Resolve type factory namespace — tries ns0, ns1, tns, then full URI."""
    for ns_prefix in ("ns0", "ns1", "tns"):
        try:
            factory = client.type_factory(ns_prefix)
            _       = factory.CmSelectionCriteria   # sanity check
            log.info(f"[M1] Type factory namespace: {ns_prefix}")
            return factory
        except Exception:
            continue

    # Full URI fallback
    factory = client.type_factory("http://schemas.cisco.com/ast/soap")
    log.info("[M1] Type factory namespace: full URI")
    return factory


def _m1_query_chunk(service, factory, chunk, chunk_size):
    """Run one chunk query using Zeep type factory objects."""
    select_items = factory.ArrayOfSelectItem(
        item=[factory.SelectItem(Item=name) for name in chunk]
    )
    criteria = factory.CmSelectionCriteria(
        **OrderedDict([
            ("MaxReturnedDevices", chunk_size),
            ("SelectBy",           "Name"),
            ("Status",             "Any"),
            ("NodeName",           ""),
            ("SelectItems",        select_items),
            ("Protocol",           "Any"),
            ("DownloadStatus",     "Any"),
        ])
    )
    response = service.selectCmDeviceExt(StateInfo="", CmSelectionCriteria=criteria)
    return parse_zeep_response(response)


def method1_query(cucm_host, username, password, device_names,
                  verify_ssl=False, chunk_size=200):
    """
    METHOD 1: Zeep Type Factory
    Builds typed SOAP objects via Zeep's factory — cleanest approach.
    Raises exception on any failure so the caller can fall back.
    """
    if not ZEEP_AVAILABLE:
        raise ImportError("zeep is not installed — skipping Method 1")

    log.info("[M1] Starting — Zeep Type Factory")
    client, history, service = _m1_build_client(cucm_host, username, password, verify_ssl)
    factory     = _m1_get_factory(client)
    all_results = {}
    total       = (len(device_names) + chunk_size - 1) // chunk_size

    for i in range(0, len(device_names), chunk_size):
        chunk     = device_names[i:i + chunk_size]
        chunk_num = i // chunk_size + 1
        log.info(f"[M1] Chunk {chunk_num}/{total} ({len(chunk)} devices)")
        chunk_results = _m1_query_chunk(service, factory, chunk, chunk_size)
        all_results.update(chunk_results)
        log.info(f"[M1] Chunk {chunk_num}: {len(chunk_results)} records returned")

    log.info(f"[M1] SUCCESS — {len(all_results)} total devices retrieved")
    return all_results, history


# ═════════════════════════════════════════════════════════════════════════════
# METHOD 2 — ZEEP PLAIN DICT
# ═════════════════════════════════════════════════════════════════════════════

def _m2_query_chunk(service, chunk, chunk_size):
    """Run one chunk query using plain Python dicts (no type factory)."""
    select_items = {"item": [{"Item": name} for name in chunk]}

    criteria = OrderedDict([
        ("MaxReturnedDevices", chunk_size),
        ("SelectBy",           "Name"),
        ("Status",             "Any"),
        ("NodeName",           ""),
        ("SelectItems",        select_items),
        ("Protocol",           "Any"),
        ("DownloadStatus",     "Any"),
    ])

    response = service.selectCmDeviceExt(StateInfo="", CmSelectionCriteria=criteria)
    return parse_zeep_response(response)


def method2_query(cucm_host, username, password, device_names,
                  verify_ssl=False, chunk_size=200):
    """
    METHOD 2: Zeep Plain Dict
    Passes criteria as plain dicts instead of typed factory objects.
    Raises exception on any failure so the caller can fall back.
    """
    if not ZEEP_AVAILABLE:
        raise ImportError("zeep is not installed — skipping Method 2")

    log.info("[M2] Starting — Zeep Plain Dict")
    _,  _, service = _m1_build_client(cucm_host, username, password, verify_ssl)
    all_results    = {}
    total          = (len(device_names) + chunk_size - 1) // chunk_size

    for i in range(0, len(device_names), chunk_size):
        chunk     = device_names[i:i + chunk_size]
        chunk_num = i // chunk_size + 1
        log.info(f"[M2] Chunk {chunk_num}/{total} ({len(chunk)} devices)")
        chunk_results = _m2_query_chunk(service, chunk, chunk_size)
        all_results.update(chunk_results)
        log.info(f"[M2] Chunk {chunk_num}: {len(chunk_results)} records returned")

    log.info(f"[M2] SUCCESS — {len(all_results)} total devices retrieved")
    return all_results


# ═════════════════════════════════════════════════════════════════════════════
# METHOD 3 — RAW SOAP (requests only, zero Zeep dependency)
# ═════════════════════════════════════════════════════════════════════════════

def _m3_build_envelope(device_names, chunk_size):
    """Build raw SOAP XML envelope with strict element ordering."""
    items_xml = "\n          ".join(
        f"<soap:SelectItem><soap:Item>{name}</soap:Item></soap:SelectItem>"
        for name in device_names
    )
    return f"""<?xml version="1.0" encoding="UTF-8"?>
<soapenv:Envelope
    xmlns:soapenv="http://schemas.xmlsoap.org/soap/envelope/"
    xmlns:soap="http://schemas.cisco.com/ast/soap">
  <soapenv:Header/>
  <soapenv:Body>
    <soap:selectCmDeviceExt>
      <soap:StateInfo></soap:StateInfo>
      <soap:CmSelectionCriteria>
        <soap:MaxReturnedDevices>{chunk_size}</soap:MaxReturnedDevices>
        <soap:SelectBy>Name</soap:SelectBy>
        <soap:Status>Any</soap:Status>
        <soap:NodeName></soap:NodeName>
        <soap:SelectItems>
          {items_xml}
        </soap:SelectItems>
        <soap:Protocol>Any</soap:Protocol>
        <soap:DownloadStatus>Any</soap:DownloadStatus>
      </soap:CmSelectionCriteria>
    </soap:selectCmDeviceExt>
  </soapenv:Body>
</soapenv:Envelope>"""


def _m3_send(cucm_host, username, password, soap_body, verify_ssl):
    """POST raw SOAP envelope and return response text."""
    url = f"https://{cucm_host}:8443/realtimeservice2/services/RISService70"
    headers = {
        "Content-Type": "text/xml; charset=utf-8",
        "SOAPAction":   '""',
    }
    response = requests.post(
        url,
        data=soap_body.encode("utf-8"),
        headers=headers,
        auth=HTTPBasicAuth(username, password),
        verify=verify_ssl,
        timeout=60,
    )
    response.raise_for_status()
    return response.text


def method3_query(cucm_host, username, password, device_names,
                  verify_ssl=False, chunk_size=200):
    """
    METHOD 3: Raw SOAP via requests
    Bypasses Zeep entirely — maximum control over XML structure.
    Most reliable method for strict CUCM SOAP parsers.
    Raises exception on failure.
    """
    log.info("[M3] Starting — Raw SOAP (requests)")
    all_results = {}
    total       = (len(device_names) + chunk_size - 1) // chunk_size

    for i in range(0, len(device_names), chunk_size):
        chunk     = device_names[i:i + chunk_size]
        chunk_num = i // chunk_size + 1
        log.info(f"[M3] Chunk {chunk_num}/{total} ({len(chunk)} devices)")

        soap_body     = _m3_build_envelope(chunk, chunk_size)
        xml_response  = _m3_send(cucm_host, username, password, soap_body, verify_ssl)
        chunk_results = parse_xml_response(xml_response)
        all_results.update(chunk_results)
        log.info(f"[M3] Chunk {chunk_num}: {len(chunk_results)} records returned")

    log.info(f"[M3] SUCCESS — {len(all_results)} total devices retrieved")
    return all_results


# ═════════════════════════════════════════════════════════════════════════════
# FALLBACK ORCHESTRATOR
# ═════════════════════════════════════════════════════════════════════════════

def query_with_fallback(cucm_host, username, password, device_names,
                        verify_ssl=False, chunk_size=200):
    """
    Try Method 1 → Method 2 → Method 3 in order.
    Returns (results_dict, method_used_str).
    Raises RuntimeError only if ALL three methods fail.
    """
    # ── Method 1: Zeep Type Factory ──────────────────────────────────────────
    try:
        results, _ = method1_query(
            cucm_host, username, password, device_names, verify_ssl, chunk_size
        )
        return results, "Method 1 (Zeep Type Factory)"
    except Exception as e:
        log.warning(f"[M1] Failed: {e}")
        log.warning("[M1] → Falling back to Method 2 (Zeep Plain Dict)")

    # ── Method 2: Zeep Plain Dict ─────────────────────────────────────────────
    try:
        results = method2_query(
            cucm_host, username, password, device_names, verify_ssl, chunk_size
        )
        return results, "Method 2 (Zeep Plain Dict)"
    except Exception as e:
        log.warning(f"[M2] Failed: {e}")
        log.warning("[M2] → Falling back to Method 3 (Raw SOAP)")

    # ── Method 3: Raw SOAP ────────────────────────────────────────────────────
    try:
        results = method3_query(
            cucm_host, username, password, device_names, verify_ssl, chunk_size
        )
        return results, "Method 3 (Raw SOAP)"
    except Exception as e:
        log.error(f"[M3] Failed: {e}")
        raise RuntimeError(
            "All three query methods failed. "
            "Check CUCM hostname, credentials, network access to port 8443, "
            "and that the account has the 'Standard RealtimeAndTraceCollection' role."
        ) from e


